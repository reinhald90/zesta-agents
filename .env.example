# ── AI providers (opsional; jika kosong, MockProvider dipakai) ────────────
# OpenAI-compatible (OpenAI, Together, Groq, OpenRouter, dsb.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Pilih provider default: openai | anthropic | gemini | mock
ZESTA_DEFAULT_PROVIDER=mock

